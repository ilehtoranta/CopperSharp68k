<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.win-x64" Version="[10.0.9]" />
    <None Include="$(NuGetPackageRoot)/microsoft.netcore.app.runtime.win-x64/10.0.9/runtimes/win-x64/lib/net10.0/System.Private.CoreLib.dll"
          Link="PinnedCoreLib/10.0.9/System.Private.CoreLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
	<None Update="Baselines\net10.0-profile-baseline.json"
	      CopyToOutputDirectory="PreserveNewest" />
	<None Update="Baselines\net10.0-compatibility-ledger.json"
	      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compiler\CopperSharp.Compiler.csproj" />
	<ProjectReference Include="..\Compiler.Tests.PackageDependency\CopperSharp.Compiler.Tests.PackageDependency.csproj" />
	<ProjectReference Include="..\Compiler.Tests.FunctionAddressFixtures\CopperSharp.Compiler.Tests.FunctionAddressFixtures.csproj" />
	<ProjectReference Include="..\Compiler.Tests.PromotedLocalFixture\CopperSharp.Compiler.Tests.PromotedLocalFixture.csproj" />
    <ProjectReference Include="..\Compiler.Tests.MultiModule\CopperSharp.Compiler.Tests.MultiModule.csproj" />
    <ProjectReference Include="..\Runtime.Managed\CopperSharp.Runtime.Managed.csproj" />
    <ProjectReference Include="..\Runtime.AmigaPal\CopperSharp.Runtime.AmigaPal.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\CopperSharp.Sdk.Amiga.csproj" />
    <ProjectReference Include="..\Sdk.Amiga.Support\CopperSharp.Sdk.Amiga.Support.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\DOS\DOS.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\FileStats\FileStats.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\IFFInspect\IFFInspect.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\MUISunflower\MUISunflower.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\MUITaskList\MUITaskList.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\Polymorphism\Polymorphism.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\ConsoleIO\ConsoleIO.csproj" />
	<ProjectReference Include="..\Sdk.Amiga\Examples\CopperBars\CopperBars.csproj" />
    <ProjectReference Include="..\Sdk.Amiga\Examples\StopwatchBenchmark\StopwatchBenchmark.csproj" />
    <ProjectReference Include="..\Targets.Amiga\CopperSharp.Targets.Amiga.csproj" />
    <PackageReference Include="Copper68k" Version="1.5.1" />
  </ItemGroup>

</Project>
