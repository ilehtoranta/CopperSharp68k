<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591;1701;1702;NU1900</NoWarn>
    <PackageId>Copper68k.Compiler</PackageId>
    <Title>Copper68k Compiler</Title>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Optional closed-world CIL to Motorola 68000-family ahead-of-time compiler with Amiga HUNK and Kickstart ROM output.</Description>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ilehtoranta/CopperSharp68k</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilehtoranta/CopperSharp68k.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>compiler;aot;cil;amiga;hunk;kickstart;m68000;m68020;m68040</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Copper68k.Compiler.targets"
          Pack="true"
          PackagePath="buildTransitive\Copper68k.Compiler.targets" />
  </ItemGroup>

</Project>
