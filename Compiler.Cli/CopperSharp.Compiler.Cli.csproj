<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>copper68kc</ToolCommandName>
    <PackageId>CopperSharp.Compiler.Cli</PackageId>
    <Title>CopperSharp Compiler CLI</Title>
    <Description>Command-line driver for the CopperSharp CIL-to-68k compiler.</Description>
    <PackageTags>compiler;dotnet-tool;aot;cil;amiga;m68k</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compiler\CopperSharp.Compiler.csproj" />
    <ProjectReference Include="..\Targets.Amiga\CopperSharp.Targets.Amiga.csproj" />
    <ProjectReference Include="..\Runtime.Managed\CopperSharp.Runtime.Managed.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
