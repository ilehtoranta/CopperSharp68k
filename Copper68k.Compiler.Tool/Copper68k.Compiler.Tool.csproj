<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>copper68kc</ToolCommandName>
    <PackageId>Copper68k.Compiler.Tool</PackageId>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Command-line driver for the Copper68k CIL-to-68k compiler.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Copper68k.Compiler\Copper68k.Compiler.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
