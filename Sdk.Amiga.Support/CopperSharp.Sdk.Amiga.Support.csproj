<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>CopperSharp.Sdk.Amiga.Support</PackageId>
    <Title>CopperSharp Amiga host support</Title>
    <Description>Host-side guest-memory codecs and inspection helpers for CopperSharp Amiga tooling and emulators.</Description>
    <PackageTags>amiga;m68k;emulation;tooling;guest-memory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sdk.Amiga\CopperSharp.Sdk.Amiga.csproj" />
    <Compile Include="..\Sdk.Amiga\GuestMemory\**\*.cs" Link="GuestMemory\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Sdk.Amiga\BOOPSI\GuestCodecs.cs" Link="BOOPSI\GuestCodecs.cs" />
    <Compile Include="..\Sdk.Amiga\DOS\GuestCodecs.cs" Link="DOS\GuestCodecs.cs" />
	<Compile Include="..\Sdk.Amiga\Exec\GuestCodecs.cs" Link="Exec\GuestCodecs.cs" />
    <Compile Include="..\Sdk.Amiga\Layers\GuestCodecs.cs" Link="Layers\GuestCodecs.cs" />
    <Compile Include="..\Sdk.Amiga\MUIMaster\GuestCodecs.cs" Link="MUIMaster\GuestCodecs.cs" />
    <Compile Include="..\Sdk.Amiga\Utility\GuestCodecs.cs" Link="Utility\GuestCodecs.cs" />
    <Compile Include="..\Sdk.Amiga\Utility\UtilityHookCodec.cs" Link="Utility\UtilityHookCodec.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
